# Converso Environment Configuration Example
# Copy this file to '.env' and fill in your values.

# 1. Security Configuration
# The encryption key used to encrypt/decrypt sensitive chat history messages at rest.
# Must be a 32-byte URL-safe base64-encoded key. Generate one using:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_fernet_symmetric_key_here

# 2. Server Configuration
# Host and port configuration for running the FastAPI backend.
HOST=0.0.0.0
PORT=8000

# 3. Model Configuration Overrides (Optional)
# Specify custom local paths if you have pre-downloaded GGUF weights elsewhere.
# MISTRAL_SMALL_PATH=./models/mistral-7b-instruct-v0.1.Q3_K_M.gguf
# MISTRAL_LARGE_PATH=./models/mistral-7b-instruct-v0.1.Q5_K_M.gguf
# LLAVA_MODEL_PATH=./models/llava/ggml-model-q5_k.gguf
# CLIP_MODEL_PATH=./models/llava/Llama-3-Update-3.0-mmproj-model-f16.gguf

# 4. Logging Configuration
# Choose logging levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
